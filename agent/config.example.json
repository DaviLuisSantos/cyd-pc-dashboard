      { "symbol": "BTC", "type": "crypto", "id": "bitcoin" },
      { "symbol": "ETH", "type": "crypto", "id": "ethereum" }
    ]
  },

  "youtube": {
    "api_key": "",
    "channel_ids": []
  },

  "discovery": {
    "enabled": true,
    "name": null
  },

  "services": [
    { "name": "Router", "check": "tcp://192.168.1.1:80" },
    { "name": "Website", "check": "https://example.com" }
